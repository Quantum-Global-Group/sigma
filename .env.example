# ═══════════════════════════════════════════════════════════════════════════════
# SIGMA — Environment template
# ═══════════════════════════════════════════════════════════════════════════════
#
# Setup:
#   cp .env.example apps/api/.env
#   cp .env.example apps/web/.env.local
#   Fill in real values. NEVER commit .env or .env.local.
#
# Legend (used in section headers):
#   [REQUIRED]     — needed for that scenario to work
#   [RECOMMENDED]  — strongly advised for production / Fly deploy
#   [OPTIONAL]     — feature works without it (disabled or uses fallback)
#   [WEB ONLY]     — apps/web/.env.local only (NEXT_PUBLIC_* also needed on Vercel)
#   [API/WORKER]   — apps/api/.env (worker reads the same file or Fly secrets)
#   [SELF-GEN]     — generate yourself (openssl rand -hex 32); not from a vendor
#
# ─── What you need by scenario ───────────────────────────────────────────────
#
#   Local UI + signals (no live trading):
#     [REQUIRED] Clerk (test keys), Stripe (test keys)
#     [SELF-GEN] SECRET_KEY, INTERNAL_SECRET
#     Docker: DATABASE_URL + REDIS_URL defaults work with `docker compose up`
#
#   Local paper worker (all asset classes, no broker):
#     Above + set *_EXECUTOR=paper for each class; no broker keys needed
#
#   M1 equity paper on Fly (Sprint 1 — see docs/SPRINT1_DEPLOY_CHECKLIST.md):
#     [REQUIRED] DATABASE_URL (Timescale Cloud), REDIS_URL (Upstash)
#     [REQUIRED] INTERNAL_SECRET (same on api + worker)
#     [REQUIRED] ALPACA_API_KEY + ALPACA_SECRET (paper)
#     [REQUIRED] TIINGO_API_KEY (OHLCV fallback)
#     [RECOMMENDED] SENTRY_DSN
#     [OPTIONAL] HUGGINGFACE_TOKEN (FinBERT sentiment)
#     Clerk + Stripe when Vercel web is deployed
#
#   Per asset class (add when enabling that class on the worker):
#     equity  → Alpaca + Tiingo
#     crypto  → Coinbase Advanced Trade keys (sandbox first)
#     forex   → OANDA_API_TOKEN + OANDA_ACCOUNT_ID (practice)
#     options → Moomoo OpenD gateway (local/VPS; no cloud API key — see MOOMOO_*)
#
# Vendor signup quick links: 03_ENV_VARS.md (repo root)
# ═══════════════════════════════════════════════════════════════════════════════


# ─── Clerk — auth [REQUIRED for web dashboard] [WEB + API] ───────────────────
# https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME
# Webhooks → Signing Secret (user sync / billing hooks)
CLERK_WEBHOOK_SECRET=whsec_REPLACE_ME
# Backend JWT verification → JWT Templates → your template → PEM public key
CLERK_JWT_KEY=REPLACE_ME
# Route URLs (match your Next.js app routes)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard


# ─── Stripe — billing & usage metering [REQUIRED for paid tiers] [WEB + API] ─
# https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
# Developers → Webhooks → signing secret (endpoint: /api/webhooks/stripe)
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
# Products → each price ID
STRIPE_PRICE_PRO=price_REPLACE_ME
STRIPE_PRICE_ENTERPRISE=price_REPLACE_ME
# Billing → Meters → "api_calls" (or your meter name)
STRIPE_METER_ID=mtr_REPLACE_ME


# ─── App secrets [SELF-GEN] [API/WORKER] ─────────────────────────────────────
# Random 256-bit secret for API session/crypto. Generate: openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-256-bit-secret-key
# Worker → API internal calls (run_cycle, promotion approve). MUST match on both Fly apps.
INTERNAL_SECRET=change-me-to-a-random-256-bit-secret-key


# ─── App URLs [WEB] ───────────────────────────────────────────────────────────
# Local split-server defaults (Makefile: dev-api 8001, dev-web 3001).
# Production: set to your Fly API URL and Vercel web URL.
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_APP_URL=http://localhost:3001


# ─── FastAPI [API/WORKER] ────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8001
# Comma-separated browser origins (Next.js) allowed to call the API.
CORS_ORIGINS=http://localhost:3001


# ─── Database [REQUIRED] [API/WORKER] ────────────────────────────────────────
# Local: docker compose (postgres + TimescaleDB)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/sigma
# Production: Timescale Cloud — must support pgvector for migration 012
# DATABASE_URL=postgresql+asyncpg://USER:PASS@HOST.tsdb.cloud:5432/tsdb?sslmode=require
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20


# ─── Redis [REQUIRED] [API/WORKER] ───────────────────────────────────────────
# Local: docker compose
REDIS_URL=redis://localhost:6379
# Production: Upstash — use rediss:// (TLS)
# REDIS_URL=rediss://default:TOKEN@HOST.upstash.io:6379
REDIS_TTL_SIGNAL=3600
REDIS_TTL_API_KEY=86400


# ─── Rate limits (Sigma API keys — not vendor keys) [API] ────────────────────
RATE_LIMIT_FREE=100
RATE_LIMIT_PRO=10000
RATE_LIMIT_ENTERPRISE=1000000


# ─── ML models [API/WORKER] ──────────────────────────────────────────────────
MODEL_DIR=./ml/saved_models
MODEL_VERSION=v1.0


# ─── MLflow — training experiment tracking [OPTIONAL] [API] ──────────────────
# Empty → local ./mlruns under apps/api. Per-family names: sigma-equity-ensemble, etc.
# MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT=sigma-training


# ─── pgvector signal embeddings [OPTIONAL] [API/WORKER] ──────────────────────
# Nightly job embeds labeled signal_history for research / similarity search.
# Requires migration 012 + CREATE EXTENSION vector on Postgres.
EMBED_SIGNALS_ENABLED=false
EMBED_SIGNALS_INTERVAL_HOURS=24
EMBED_SIGNALS_LIMIT=1000


# ─── Self-evolution scheduler [API/WORKER] ───────────────────────────────────
# Label outcomes → evaluate → train candidate → propose promotion (human approves).
WORKER_SCHEDULER_ENABLED=true
LABEL_INTERVAL_HOURS=24
TRAIN_INTERVAL_HOURS=168
EQUITY_SNAPSHOT_INTERVAL_HOURS=24
# Empty → uses WORKER_ASSET_CLASSES
SELF_EVOLVE_ASSET_CLASSES=
PROMOTION_MIN_IMPROVEMENT=0.02
PROMOTION_MIN_SAMPLES=50


# ─── IBM Quantum [OPTIONAL] [API] ────────────────────────────────────────────
# https://quantum.ibm.com/account — leave blank to use local simulator
IBM_QUANTUM_TOKEN=
IBM_QUANTUM_INSTANCE=
IBM_QUANTUM_BACKEND=ibm_brisbane


# ─── Hugging Face [OPTIONAL] [API/WORKER] ───────────────────────────────────
# Required when SENTIMENT_PROVIDER=finbert
# https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=


# ─── Observability [RECOMMENDED on Fly] [API/WORKER + WEB for Sentry JS] ─────
# https://sentry.io → New Project → Python (api/worker) and/or Next.js (web)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# https://cloud.langfuse.com → Settings → API Keys (inference tracing)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com


# ─── Equity market data [REQUIRED for equity alpha] [API/WORKER] ─────────────
# Provider order: Alpaca first (reuses ALPACA_* below), Tiingo fallback.
EQUITY_DATA_PROVIDERS=alpaca,tiingo
# https://www.tiingo.com/account/api/token
TIINGO_API_KEY=


# ─── Sentiment overlay [OPTIONAL] [API] ──────────────────────────────────────
# finbert | langextract | ollama | hybrid | none
SENTIMENT_PROVIDER=none
SENTIMENT_MIN_DOCS=3
# LangExtract / Ollama (local — no key if Ollama runs on localhost)
LX_MODEL_ID=mistral:7b-instruct
LX_MODEL_URL=http://127.0.0.1:11434
LANGEXTRACT_API_KEY=


# ─── Execution — per asset class [API/WORKER] ────────────────────────────────
# paper = simulated fills in Postgres (no broker keys).
# Set to broker name when you have keys below.
CRYPTO_EXECUTOR=paper
EQUITY_EXECUTOR=paper
OPTION_EXECUTOR=paper
FOREX_EXECUTOR=paper
# Legacy crypto-only override — overrides CRYPTO_EXECUTOR if non-paper.
# Never affects equity/forex/option. Leave "paper" unless migrating old deploys.
EXECUTOR_MODE=paper


# ─── Coinbase Advanced Trade — crypto [REQUIRED if CRYPTO_EXECUTOR=coinbase] ─
# https://portal.cdp.coinbase.com → API Keys (ECDSA key + key name)
COINBASE_API_KEY_NAME=
COINBASE_PRIVATE_KEY=
COINBASE_SANDBOX=true
# Legacy HMAC keys (pre–Advanced Trade — only if your deploy still uses them)
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_API_PASSPHRASE=


# ─── Alpaca — equities [REQUIRED if EQUITY_EXECUTOR=alpaca or equity data] ───
# Paper: https://app.alpaca.markets/paper/dashboard/overview → API Keys
ALPACA_API_KEY=
ALPACA_SECRET=
ALPACA_PAPER=true
ALPACA_ALLOW_LIVE=false
ALPACA_DATA_FEED=iex
ALPACA_ALLOW_FRACTIONAL=true
ALPACA_MAX_ORDER_NOTIONAL=0
ALPACA_MAX_ORDER_SHARES=0


# ─── OANDA — forex [REQUIRED if FOREX_EXECUTOR=oanda] ────────────────────────
# https://www.oanda.com/account/tpa/personal_token (practice + live accounts)
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice
OANDA_PAPER=true
OANDA_ALLOW_LIVE=false


# ─── MT5 bridge — forex/CFD [REQUIRED if FOREX_EXECUTOR=mt5 or FOREX_MT5_SYMBOLS] ─
# Run services/mt5-bridge on EvoX2/Windows beside a logged-in BlackBull demo MT5 terminal.
MT5_BRIDGE_URL=
MT5_BRIDGE_SECRET=
MT5_BRIDGE_TIMEOUT_SECONDS=10
MT5_BRIDGE_CANDLE_COUNT=360
MT5_PAPER=true
MT5_ALLOW_LIVE=false
# false = worker qty is base units and converts units → lots; true = qty is already lots.
MT5_QTY_IS_LOTS=false
MT5_UNITS_PER_LOT=100000
MT5_DEVIATION_POINTS=20
# Symbols routed to MT5 bridge; all other forex symbols use FOREX_EXECUTOR (usually oanda/paper).
FOREX_MT5_SYMBOLS=


# ─── Moomoo / Futu OpenD — options [REQUIRED if OPTION_EXECUTOR=moomoo] ──────
# No cloud API key: run OpenD locally or on a VPS; SDK connects to the gateway.
# Log into OpenD with your Moomoo/Futu account; see docs/DEPLOY_OPTIONS.md
MOOMOO_HOST=127.0.0.1
MOOMOO_PORT=11111
MOOMOO_TRD_MARKET=US
MOOMOO_SECURITY_FIRM=FUTUINC
MOOMOO_PAPER=true
MOOMOO_ALLOW_LIVE=false
OPEND_CHECK_ENABLED=true
# Shell command to restart OpenD when unreachable (empty = alert only)
OPEND_RESTART_COMMAND=


# ─── Worker live loop [API/WORKER] ───────────────────────────────────────────
# M1 alpha: set to equity (see apps/worker/fly.toml)
WORKER_ASSET_CLASSES=equity
WORKER_TICK_SECONDS_CRYPTO=300
WORKER_TICK_SECONDS_EQUITY=900
WORKER_TICK_SECONDS_OPTION=900
WORKER_TICK_SECONDS_FOREX=900
EQUITY_UNIVERSE=AAPL,MSFT,NVDA,GOOG,AMZN
CRYPTO_UNIVERSE=BTC-USD,ETH-USD,SOL-USD,LINK-USD,AVAX-USD
FOREX_UNIVERSE=EUR_USD,GBP_USD,AUD_USD,USD_JPY,USD_CAD
# Add MT5-only symbols here too when routing them through FOREX_MT5_SYMBOLS.

# House-book user for worker orders/signals (seeded by migration 005)
SYSTEM_USER_ID=00000000-0000-0000-0000-000000000001


# ─── Strategy combiner (no API keys) [API/WORKER] ────────────────────────────
# See docs/MODELS.md for strategy names. SDE (gbm/ou/heston) = equity daily bars only.
EQUITY_STRATEGIES=momentum,mean_reversion,breakout,regime,ml,macd,fourier,gbm,ou,heston,ict
CRYPTO_STRATEGIES=momentum,mean_reversion,breakout,regime,ml,macd,fourier
FOREX_STRATEGIES=momentum,mean_reversion,breakout,regime,ml,macd,fourier
MIN_SIGNAL_CONFIDENCE=0.3


# ─── Gumroad product links [OPTIONAL] [WEB] ────────────────────────────────────
# Landing page hides Gumroad section when blank
NEXT_PUBLIC_GUMROAD_DASHBOARD_URL=
NEXT_PUBLIC_GUMROAD_ML_URL=


# ─── Load testing [OPTIONAL] — tests/load_test.py only ───────────────────────
SIGMA_LOADTEST_BASE_URL=http://localhost:8001
# Your Sigma API key from dashboard or `make seed` — NOT a vendor key
SIGMA_LOADTEST_API_KEY=
