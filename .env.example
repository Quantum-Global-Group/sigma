# ─── Copy this file ──────────────────────────────────────────────────────────
# cp .env.example apps/api/.env
# cp .env.example apps/web/.env.local
# Then fill in real values. Never commit .env or .env.local.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Clerk (auth) ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME
# Get from: dashboard.clerk.com → Webhooks → Signing Secret
CLERK_WEBHOOK_SECRET=whsec_REPLACE_ME

# ─── Internal service-to-service auth ────────────────────────────────────────
# Must match SECRET_KEY in apps/api/.env
INTERNAL_SECRET=change-me-to-a-random-256-bit-secret-key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
# Backend JWT verification
CLERK_JWT_KEY=REPLACE_ME

# ─── Stripe ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PRICE_PRO=price_REPLACE_ME
STRIPE_PRICE_ENTERPRISE=price_REPLACE_ME
STRIPE_METER_ID=mtr_REPLACE_ME

# ─── App URLs ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── FastAPI ──────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
API_PORT=8000
SECRET_KEY=change-me-to-a-random-256-bit-secret-key

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/sigma
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_TTL_SIGNAL=3600
REDIS_TTL_API_KEY=86400

# ─── Rate limits ──────────────────────────────────────────────────────────────
RATE_LIMIT_FREE=100
RATE_LIMIT_PRO=10000
RATE_LIMIT_ENTERPRISE=1000000

# ─── ML models ────────────────────────────────────────────────────────────────
MODEL_DIR=./ml/saved_models
MODEL_VERSION=v1.0

# ─── Quantum (optional — leave blank to use simulator) ────────────────────────
IBM_QUANTUM_TOKEN=
IBM_QUANTUM_INSTANCE=
IBM_QUANTUM_BACKEND=ibm_brisbane

# ─── HuggingFace (optional) ───────────────────────────────────────────────────
HUGGINGFACE_TOKEN=

# ─── Observability (optional — leave blank to disable) ───────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ─── Market data ──────────────────────────────────────────────────────────────
# yfinance is free — no key needed
IEX_API_KEY=

# ─── Sentiment provider ──────────────────────────────────────────────────────
# finbert | langextract | ollama | hybrid | none
SENTIMENT_PROVIDER=finbert
LANGEXTRACT_API_URL=
LANGEXTRACT_API_KEY=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral:7b-instruct

# ─── Execution (worker) ──────────────────────────────────────────────────────
# paper | coinbase
EXECUTOR_MODE=paper
COINBASE_API_KEY_NAME=
COINBASE_PRIVATE_KEY=
COINBASE_SANDBOX=true

# ─── Worker live loop ────────────────────────────────────────────────────────
# Comma-separated list (crypto and/or equity)
WORKER_ASSET_CLASSES=crypto
WORKER_TICK_SECONDS_CRYPTO=300
WORKER_TICK_SECONDS_EQUITY=900
EQUITY_UNIVERSE=AAPL,MSFT,NVDA,GOOG,AMZN
CRYPTO_UNIVERSE=BTC-USD,ETH-USD,SOL-USD,LINK-USD,AVAX-USD

# Deterministic UUID seeded by migration 005 — keep in sync if you change it.
SYSTEM_USER_ID=00000000-0000-0000-0000-000000000001

# ─── Gumroad templates (optional — landing page hides the section if blank) ──
NEXT_PUBLIC_GUMROAD_DASHBOARD_URL=
NEXT_PUBLIC_GUMROAD_ML_URL=

# ─── Load testing (only used by tests/load_test.py) ──────────────────────────
SIGMA_LOADTEST_BASE_URL=http://localhost:8000
SIGMA_LOADTEST_API_KEY=
