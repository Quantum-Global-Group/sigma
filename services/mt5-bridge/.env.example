# MT5 Bridge — EvoX2 environment variables
# Copy this to .env and fill in your BlackBull demo credentials.
# See docs/EVOX2_SETUP.md for full setup instructions.

MT5_BRIDGE_HOST=0.0.0.0
MT5_BRIDGE_PORT=8787

# Shared secret — must match MT5_BRIDGE_SECRET in apps/api/.env on DGX
MT5_BRIDGE_SECRET=f67825f066cc19466fae306fed990a6883050d9801fcf04efd902bdf309a46cf

# BlackBull demo credentials (fill in yours)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=BlackBullMarkets-Demo

# Optional: full path to terminal64.exe if auto-detect fails
MT5_PATH=

MT5_PAPER=true
MT5_DEVIATION_POINTS=20
